{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lavescar-ytdl",
  "version": "1.0.0",
  "identifier": "com.lavescar.ytdl",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "lavescar ▸ yt-dlp",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/yt-dlp"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGQUIxMzgyNzBBMDVDRTUKUldUbFhLQndnaE9yUC9ucjVNVGl5N1FUcjZ1cnJxejFCSGFVMWlTTHFjTmZKVm5wQzZWS3pVMHUK",
      "endpoints": [
        "https://github.com/lavescar-dev/lavescar-ytdl/releases/latest/download/latest.json"
      ]
    }
  }
}
